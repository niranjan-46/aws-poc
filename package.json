{
  "name": "aws-poc-monorepo",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix apps/frontend",
    "lint:frontend": "npm run lint --prefix apps/frontend",
    "build:frontend": "npm run build --prefix apps/frontend",
    "dev:backend": "mvn spring-boot:run -Dspring-boot.run.profiles=prod -f apps/backend/pom.xml",
    "build:backend": "mvn -DskipTests package -f apps/backend/pom.xml",
    "verify": "npm run lint:frontend && npm run build:backend"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
